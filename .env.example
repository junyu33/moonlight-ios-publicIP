# Hostname used by Moonlight iOS.
# Use a HTTP-clean hostname with no HSTS / HTTPS-only history.
MOON_HOST=moon.example.test

# Sunshine host's VPN/LAN IP used during first Add/Pair.
LAN_IP=10.0.42.1

# Interface that receives VPN/LAN traffic from iPhone.
WG_IFACE=moonwg0

# WireGuard helper defaults.
WG_PORT=51820
WG_SERVER_ADDR=10.0.42.1/24
WG_CLIENT_NAME=iphone
WG_CLIENT_ADDR=10.0.42.2/32
WG_DNS=10.0.42.1
WG_ALLOWED_IPS=10.0.42.0/24
# Set this only when generating the iOS client config.
# WG_ENDPOINT=moon.example.test:51820

# Public interface that receives Internet traffic.
PUBLIC_IFACE=enp3s0

# Upstream DNS used by dnsmasq for non-Moonlight names.
UPSTREAM_DNS=8.8.8.8

# Temporary runtime paths.
DNSMASQ_CONF=/tmp/moon-dnsmasq.conf
DNSMASQ_PID=/tmp/moon-dnsmasq.pid
DNSMASQ_LOG=/tmp/moon-dnsmasq.log
ADD_CAPTURE=/tmp/moon-add.txt
PUBLIC_CAPTURE=/tmp/moon-public.txt
NFT_COMMENT=moonlight-ios-publicIP
NFT_PUBLIC_COMMENT=moonlight-ios-publicIP:public
NFT_VPN_COMMENT=moonlight-ios-publicIP:vpn
